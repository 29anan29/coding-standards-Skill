# EditorConfig

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{c,h,cpp,hpp,cc}]
indent_style = tab
indent_size = 8

[*.go]
indent_style = tab
indent_size = 8

[*.rs]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,ts,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab